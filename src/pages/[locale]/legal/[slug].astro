---
import Breadcrumbs from "@/components/layout/breadcrumbs.astro"
import BaseLayout from "@/components/layout/base-layout.astro"
import { isLegalSlug, LEGAL_SLUGS, legalCopy } from "@/content/legal"
import { navCopy } from "@/content/copy"
import { isLocale, locales } from "@/lib/i18n"
import { defaultHomeHref } from "@/lib/paths"
import { SITE_NAME } from "@/lib/site"
import { breadcrumbJsonLd } from "@/lib/seo/schema"

export const prerender = true
export const getStaticPaths = () =>
	locales.flatMap((locale) => LEGAL_SLUGS.map((slug) => ({ params: { locale, slug } })))

const localeParam = Astro.params.locale ?? ""
const slugParam = Astro.params.slug ?? ""
if (!isLocale(localeParam) || !isLegalSlug(slugParam)) {
	return Astro.redirect(defaultHomeHref, 308)
}
const locale = localeParam
const slug = slugParam
const doc = legalCopy[locale][slug]
const crumbs = [
	{ name: navCopy[locale].home, path: "/" },
	{ name: doc.title, path: `/legal/${slug}` },
]
---

<BaseLayout
	locale={locale}
	page={{
		description: doc.description,
		path: `/legal/${slug}`,
		title: `${doc.title} | ${SITE_NAME}`,
	}}
	jsonLd={breadcrumbJsonLd(locale, crumbs)}
>
	<Breadcrumbs locale={locale} crumbs={crumbs} />
	<h1 class="text-4xl sm:text-5xl">{doc.title}</h1>
	{
		doc.sections.map((section) => (
			<section class="mt-10">
				<h2 class="text-2xl">{section.heading}</h2>
				{section.paragraphs.map((paragraph) => (
					<p class="mt-3 max-w-2xl text-muted">{paragraph}</p>
				))}
			</section>
		))
	}
</BaseLayout>
