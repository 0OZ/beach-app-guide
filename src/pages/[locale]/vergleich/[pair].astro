---
import MatrixTable from "@/components/compare/matrix-table.astro"
import FaqList from "@/components/compare/faq-list.astro"
import Breadcrumbs from "@/components/layout/breadcrumbs.astro"
import BaseLayout from "@/components/layout/base-layout.astro"
import { COMPARISON_PAIRS, getPair, isPairSlug } from "@/catalog/pairs"
import { hubCopy, navCopy, pairCopy } from "@/content/copy"
import { vsFaqs } from "@/content/faqs"
import { isLocale, locales } from "@/lib/i18n"
import { breadcrumbJsonLd, vsFaqJsonLd } from "@/lib/seo/schema"
import { defaultHomeHref, pagePath } from "@/lib/paths"
import { appCopy } from "@/content/apps"
import { REVIEWED_AT } from "@/lib/site"

export const prerender = true
export const getStaticPaths = () => locales.flatMap((locale) => COMPARISON_PAIRS.map((pair) => ({ params: { locale, pair: pair.slug } })))
const localeParam = Astro.params.locale ?? ""
const pairParam = Astro.params.pair ?? ""
if (!isLocale(localeParam) || !isPairSlug(pairParam)) return Astro.redirect(defaultHomeHref, 308)
const locale = localeParam
const pair = getPair(pairParam)
const copy = pairCopy[locale][pair.slug]
const shared = hubCopy[locale]
const faqTitle = locale === "de" ? "Gut zu wissen" : "Good to know"
const crumbs = [{ name: navCopy[locale].home, path: "/" }, { name: copy.h1, path: `/vergleich/${pair.slug}` }]
---

<BaseLayout locale={locale} page={{ description: copy.description, path: `/vergleich/${pair.slug}`, title: copy.title }} jsonLd={[breadcrumbJsonLd(locale, crumbs), vsFaqJsonLd(pair.slug, locale)]}>
	<Breadcrumbs locale={locale} crumbs={crumbs} />
	<p class="eyebrow">{shared.reviewedPrefix} <time datetime={REVIEWED_AT}>{REVIEWED_AT}</time></p>
	<h1 class="mt-4 text-4xl sm:text-5xl">{copy.h1}</h1>
	<p class="mt-5 max-w-2xl text-lg text-muted">{copy.intro}</p>
	<aside class="disclosure mt-8">{shared.disclosure} <a href={pagePath(locale, "/methodik")}>{shared.methodologyLink} →</a></aside>
	<section class="section" aria-labelledby="matrix-heading">
		<h2 id="matrix-heading">{shared.matrixHeading}</h2>
		<p class="section-intro">{shared.matrixCaption}</p>
		<MatrixTable ids={[pair.left, pair.right]} locale={locale} caption={copy.h1} />
		<p class="table-note">{shared.matrixNote}</p>
	</section>
	<section class="soft-card section" aria-labelledby="fit-heading">
		<h2 id="fit-heading">{locale === "de" ? "Welche passt zu dir?" : "Which fits your game?"}</h2>
		<p class="mt-4 max-w-3xl text-muted">{copy.verdict}</p>
		<div class="hero-actions">
			{[pair.left, pair.right].map((id) => <a class="text-link" href={pagePath(locale, `/apps/${id}`)}>{appCopy[locale][id].name} {locale === "de" ? "ansehen" : "profile"} →</a>)}
		</div>
	</section>
	<FaqList items={vsFaqs[pair.slug][locale]} title={faqTitle} />
</BaseLayout>
