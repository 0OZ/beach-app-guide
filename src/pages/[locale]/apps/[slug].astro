---
import { APP_IDS, getApp, isAppId } from "@/catalog/apps"
import { COMPARISON_PAIRS } from "@/catalog/pairs"
import AppCta from "@/components/compare/app-cta.astro"
import Breadcrumbs from "@/components/layout/breadcrumbs.astro"
import BaseLayout from "@/components/layout/base-layout.astro"
import { appCopy } from "@/content/apps"
import { hubCopy, navCopy } from "@/content/copy"
import { isLocale, locales } from "@/lib/i18n"
import { defaultHomeHref, pagePath } from "@/lib/paths"
import { REVIEWED_AT, SITE_BASE } from "@/lib/site"
import { breadcrumbJsonLd, profileSoftwareJsonLd } from "@/lib/seo/schema"

export const prerender = true
export const getStaticPaths = () => locales.flatMap((locale) => APP_IDS.map((slug) => ({ params: { locale, slug } })))
const localeParam = Astro.params.locale ?? ""
const slugParam = Astro.params.slug ?? ""
if (!isLocale(localeParam) || !isAppId(slugParam)) return Astro.redirect(defaultHomeHref, 308)
const locale = localeParam
const slug = slugParam
const app = getApp(slug)
const copy = appCopy[locale][slug]
const shared = hubCopy[locale]
const crumbs = [{ name: navCopy[locale].home, path: "/" }, { name: copy.name, path: `/apps/${slug}` }]
const related = COMPARISON_PAIRS.filter((pair) => pair.left === slug || pair.right === slug)
---

<BaseLayout locale={locale} page={{ description: copy.summary, path: `/apps/${slug}`, title: copy.pageTitle }} jsonLd={[breadcrumbJsonLd(locale, crumbs), profileSoftwareJsonLd(slug, locale)]}>
	<Breadcrumbs locale={locale} crumbs={crumbs} />
	<div class="profile-top mt-6">
		<img class="app-avatar" src={`${SITE_BASE}/icons/${app.icon}`} width="48" height="48" alt="" />
		<p class="eyebrow">{copy.fit}</p>
	</div>
	<h1 class="mt-4 text-4xl sm:text-5xl">{copy.pageH1}</h1>
	<p class="mt-5 max-w-2xl text-lg text-muted">{copy.bestFor}</p>
	<p class="mt-4 text-xs text-muted">{shared.reviewedPrefix} <time datetime={REVIEWED_AT}>{REVIEWED_AT}</time></p>
	<aside class="disclosure mt-8">{shared.disclosure} <a href={pagePath(locale, "/methodik")}>{shared.methodologyLink} →</a></aside>
	<section class="section" aria-labelledby="overview-heading">
		<h2 id="overview-heading">{locale === "de" ? "Was die App anbietet" : "What the app offers"}</h2>
		{copy.body.map((paragraph) => <p class="mt-4 max-w-3xl text-muted">{paragraph}</p>)}
		{copy.clubNote && <p class="mt-4 max-w-3xl text-sm text-muted">{copy.clubNote}</p>}
	</section>
	<section class="soft-card section" aria-labelledby="costs-heading">
		<h2 id="costs-heading">{locale === "de" ? "Kosten & Einordnung" : "Pricing & context"}</h2>
		<p class="mt-4 text-muted">{copy.pricing}</p>
		<p class="mt-3 text-sm text-muted">{copy.caveat}</p>
	</section>
	<section class="section" aria-labelledby="limits-heading">
		<h2 id="limits-heading">{locale === "de" ? "Was du vorab prüfen solltest" : "What to check first"}</h2>
		<ul class="mt-4 max-w-3xl list-disc space-y-2 pl-5 text-muted">{copy.limitations.map((item) => <li>{item}</li>)}</ul>
		<a class="text-link mt-5 inline-block" href={`${pagePath(locale, "/")}#features`}>{shared.compareCta} →</a>
	</section>
	{related.length > 0 && <section class="section" aria-labelledby="related-heading">
		<h2 id="related-heading">{locale === "de" ? "Im direkten Vergleich" : "Head-to-head"}</h2>
		<ul class="compare-links list-none p-0">{related.map((pair) => <li><a class="compare-link" href={pagePath(locale, `/vergleich/${pair.slug}`)}>{appCopy[locale][pair.left].name} vs. {appCopy[locale][pair.right].name} <span aria-hidden="true">→</span></a></li>)}</ul>
	</section>}
	<AppCta id={slug} locale={locale} />
</BaseLayout>
