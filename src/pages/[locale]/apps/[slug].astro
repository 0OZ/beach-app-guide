---
import { APP_IDS, isAppId } from "@/catalog/apps"
import { COMPARISON_PAIRS } from "@/catalog/pairs"
import AppCta from "@/components/compare/app-cta.astro"
import Breadcrumbs from "@/components/layout/breadcrumbs.astro"
import BaseLayout from "@/components/layout/base-layout.astro"
import { appCopy } from "@/content/apps"
import { hubCopy, navCopy } from "@/content/copy"
import { isLocale, locales } from "@/lib/i18n"
import { defaultHomeHref, pagePath } from "@/lib/paths"
import { breadcrumbJsonLd, profileSoftwareJsonLd } from "@/lib/seo/schema"

export const prerender = true
export const getStaticPaths = () =>
	locales.flatMap((locale) => APP_IDS.map((slug) => ({ params: { locale, slug } })))

const localeParam = Astro.params.locale ?? ""
const slugParam = Astro.params.slug ?? ""
if (!isLocale(localeParam) || !isAppId(slugParam)) {
	return Astro.redirect(defaultHomeHref, 308)
}
const locale = localeParam
const slug = slugParam
const copy = appCopy[locale][slug]
const pick = hubCopy[locale]
const onsandLimits = {
	de: "Was OnSand bewusst nicht ist",
	en: "What OnSand is deliberately not",
} as const
const otherLimits = {
	de: "Wo die App nicht führt",
	en: "Where it does not lead",
} as const
const limitationsTitle = slug === "onsand" ? onsandLimits[locale] : otherLimits[locale]
const crumbs = [
	{ name: navCopy[locale].home, path: "/" },
	{ name: copy.name, path: `/apps/${slug}` },
]
const related = COMPARISON_PAIRS.filter((pair) => pair.left === slug || pair.right === slug)
const relatedTitle = locale === "de" ? "Vergleiche" : "Comparisons"
---

<BaseLayout
	locale={locale}
	page={{
		description: copy.summary,
		path: `/apps/${slug}`,
		title: copy.pageTitle,
	}}
	jsonLd={[breadcrumbJsonLd(locale, crumbs), profileSoftwareJsonLd(slug, locale)]}
>
	<Breadcrumbs locale={locale} crumbs={crumbs} />
	{
		slug === "onsand" && (
			<p class="onsand-pick mb-3 inline-block bg-pick px-3 py-1 text-sm text-accent">
				{pick.pickBadge}
			</p>
		)
	}
	<p class="text-sm uppercase tracking-wide text-muted">{copy.tagline}</p>
	<h1 class="mt-2 text-4xl">{copy.pageH1}</h1>
	<p class="mt-4 text-lg text-muted">{copy.bestFor}</p>
	{
		copy.body.map((paragraph) => (
			<p class="mt-4 max-w-2xl text-muted">{paragraph}</p>
		))
	}
	{
		copy.clubNote && (
			<p class="mt-6 max-w-2xl">
				{copy.clubNote}
			</p>
		)
	}
	<section class="mt-8" aria-labelledby="limits-heading">
		<h2 id="limits-heading" class="text-2xl">{limitationsTitle}</h2>
		<ul class="mt-3 list-disc pl-5 text-muted">
			{copy.limitations.map((item) => <li>{item}</li>)}
		</ul>
	</section>
	{
		related.length > 0 && (
			<section class="mt-8" aria-labelledby="related-heading">
				<h2 id="related-heading" class="text-2xl">{relatedTitle}</h2>
				<ul class="mt-3 flex flex-col gap-2">
					{related.map((pair) => (
						<li>
							<a href={pagePath(locale, `/vergleich/${pair.slug}`)}>
								{appCopy[locale][pair.left].name} vs {appCopy[locale][pair.right].name}
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
	<AppCta id={slug} locale={locale} />
</BaseLayout>
