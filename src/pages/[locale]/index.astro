---
import { APP_IDS } from "@/catalog/apps"
import { COMPARISON_PAIRS } from "@/catalog/pairs"
import { ONSAND_APP_URL } from "@/catalog/urls"
import { appCopy } from "@/content/apps"
import { hubCopy } from "@/content/copy"
import { hubFaqs } from "@/content/faqs"
import FaqList from "@/components/compare/faq-list.astro"
import MatrixTable from "@/components/compare/matrix-table.astro"
import BaseLayout from "@/components/layout/base-layout.astro"
import { isLocale, locales } from "@/lib/i18n"
import { REVIEWED_AT } from "@/lib/site"
import { hubFaqJsonLd, hubItemListJsonLd, websiteJsonLd } from "@/lib/seo/schema"
import { defaultHomeHref, pagePath } from "@/lib/paths"

export const prerender = true
export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }))

const localeParam = Astro.params.locale ?? ""
if (!isLocale(localeParam)) {
	return Astro.redirect(defaultHomeHref, 308)
}
const locale = localeParam
const copy = hubCopy[locale]
const faqTitle = locale === "de" ? "Häufige Fragen" : "Frequently asked questions"
---

<BaseLayout
	locale={locale}
	page={{ description: copy.description, path: "/", title: copy.title }}
	jsonLd={[websiteJsonLd(locale), hubItemListJsonLd(locale), hubFaqJsonLd(locale)]}
>
	<p class="eyebrow">{copy.eyebrow}</p>
	<h1 class="mt-3 text-4xl sm:text-6xl">{copy.h1}</h1>
	<p class="mt-6 max-w-2xl text-lg text-muted sm:text-xl">{copy.intro}</p>
	<p class="eyebrow mt-4">{copy.reviewedPrefix}: {REVIEWED_AT}</p>

	<aside class="onsand-pick court-frame mt-12 bg-pick p-6 sm:p-8" aria-label={copy.pickBadge}>
		<p class="eyebrow text-accent">{copy.pickBadge}</p>
		<p class="mt-3 font-display text-2xl font-semibold text-ink sm:text-3xl">{copy.pickLead}</p>
		<a class="cta-button onsand-pick mt-6" href={ONSAND_APP_URL} rel="noopener">
			{copy.pickCta}
		</a>
	</aside>

	<section class="mt-16" aria-labelledby="matrix-heading">
		<hr class="court-rule" />
		<h2 id="matrix-heading" class="mt-6 text-3xl">{copy.matrixHeading}</h2>
		<div class="mt-6">
			<MatrixTable locale={locale} caption={copy.matrixCaption} />
		</div>
	</section>

	<section class="mt-16" aria-labelledby="profiles-heading">
		<hr class="court-rule" />
		<h2 id="profiles-heading" class="mt-6 text-3xl">{copy.profilesHeading}</h2>
		<ul class="mt-6 grid list-none gap-5 p-0 sm:grid-cols-2">
			{
				APP_IDS.map((id) => (
					<li
						class:list={[
							"p-5 sm:p-6",
							id === "onsand"
								? "onsand-pick court-frame bg-pick sm:col-span-2"
								: "profile-card",
						]}
					>
						{id === "onsand" && <p class="eyebrow text-accent">{copy.pickBadge}</p>}
						<a
							class="font-display text-xl font-semibold text-ink no-underline"
							href={pagePath(locale, `/apps/${id}`)}
						>
							{appCopy[locale][id].name}
						</a>
						<p class="mt-2 text-sm text-muted">{appCopy[locale][id].summary}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-16" aria-labelledby="vs-heading">
		<hr class="court-rule" />
		<h2 id="vs-heading" class="mt-6 text-3xl">{copy.vsHeading}</h2>
		<ul class="mt-6 flex list-none flex-col gap-3 p-0">
			{
				COMPARISON_PAIRS.map((pair) => (
					<li class="profile-card">
						<a
							class="mark flex items-baseline justify-between gap-3 px-5 py-4 text-ink no-underline"
							href={pagePath(locale, `/vergleich/${pair.slug}`)}
						>
							<span>
								{appCopy[locale][pair.left].name}
								<span class="text-flag"> vs </span>
								{appCopy[locale][pair.right].name}
							</span>
							<span aria-hidden="true">→</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-16" aria-labelledby="also-heading">
		<hr class="court-rule" />
		<h2 id="also-heading" class="mt-6 text-3xl">{copy.alsoConsidered}</h2>
		<p class="mt-4 max-w-2xl text-muted">
			<a href="https://spontacts.com" rel="noopener">{copy.spontacts}</a>
			{" — "}
			{copy.alsoConsideredBody}
		</p>
	</section>

	<FaqList items={hubFaqs[locale]} title={faqTitle} />
</BaseLayout>
