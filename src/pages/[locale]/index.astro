---
import { APP_IDS, getApp } from "@/catalog/apps"
import { COMPARISON_PAIRS } from "@/catalog/pairs"
import { appCopy } from "@/content/apps"
import { hubCopy } from "@/content/copy"
import { hubFaqs } from "@/content/faqs"
import FaqList from "@/components/compare/faq-list.astro"
import MatrixTable from "@/components/compare/matrix-table.astro"
import BaseLayout from "@/components/layout/base-layout.astro"
import { isLocale, locales } from "@/lib/i18n"
import { REVIEWED_AT, SITE_BASE } from "@/lib/site"
import { hubFaqJsonLd, hubItemListJsonLd, websiteJsonLd } from "@/lib/seo/schema"
import { defaultHomeHref, pagePath } from "@/lib/paths"

export const prerender = true
export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }))
const localeParam = Astro.params.locale ?? ""
if (!isLocale(localeParam)) return Astro.redirect(defaultHomeHref, 308)
const locale = localeParam
const copy = hubCopy[locale]
const faqTitle = locale === "de" ? "Gut zu wissen" : "Good to know"
---

<BaseLayout locale={locale} page={{ description: copy.description, path: "/", title: copy.title }} jsonLd={[websiteJsonLd(locale), hubItemListJsonLd(locale), hubFaqJsonLd(locale)]}>
	<section class="hero" aria-labelledby="guide-heading">
		<div>
			<p class="eyebrow">{copy.eyebrow}</p>
			<h1 id="guide-heading">{copy.h1}</h1>
			<p class="hero-intro">{copy.intro}</p>
			<div class="hero-actions">
				<a class="cta-button" href="#features">{copy.compareCta}<span class="ml-3" aria-hidden="true">↓</span></a>
				<span class="text-xs text-muted">{copy.reviewedPrefix} <time datetime={REVIEWED_AT}>{REVIEWED_AT}</time></span>
			</div>
		</div>
		<ul class="hero-index list-none" aria-label={copy.profilesHeading}>
			{APP_IDS.map((id) => (
				<li><a href={pagePath(locale, `/apps/${id}`)}>
					<img class="app-avatar" src={`${SITE_BASE}/icons/${getApp(id).icon}`} alt="" width="48" height="48" />
					<span class="font-semibold">{appCopy[locale][id].name}<small>{appCopy[locale][id].fit}</small></span>
					<span class="ml-auto text-muted" aria-hidden="true">↗</span>
				</a></li>
			))}
		</ul>
	</section>
	<aside class="disclosure">
		{copy.disclosure} <a href={pagePath(locale, "/methodik")}>{copy.methodologyLink} →</a>
	</aside>

	<section class="section" id="profiles" aria-labelledby="profiles-heading">
		<h2 id="profiles-heading">{copy.profilesHeading}</h2>
		<p class="section-intro">{copy.profilesIntro}</p>
		<ul class="profile-grid">
			{APP_IDS.map((id) => (
				<li class="profile-card">
					<div class="profile-top">
						<img class="app-avatar" src={`${SITE_BASE}/icons/${getApp(id).icon}`} alt="" width="48" height="48" loading="lazy" />
						<div><h3>{appCopy[locale][id].name}</h3><span class="text-xs text-muted">{appCopy[locale][id].fit}</span></div>
					</div>
					<p>{appCopy[locale][id].summary}</p>
					<p class="mt-3">{appCopy[locale][id].pricing}</p>
					<a class="text-link" href={pagePath(locale, `/apps/${id}`)} aria-label={`${appCopy[locale][id].name}: ${copy.profileLink}`}>{copy.profileLink} <span aria-hidden="true">→</span></a>
				</li>
			))}
		</ul>
	</section>

	<section class="section" id="features" aria-labelledby="matrix-heading">
		<h2 id="matrix-heading">{copy.matrixHeading}</h2>
		<p class="section-intro">{copy.matrixCaption}</p>
		<MatrixTable locale={locale} caption={copy.matrixHeading} />
		<p class="table-note">{copy.matrixNote}</p>
	</section>

	<section class="section" aria-labelledby="vs-heading">
		<h2 id="vs-heading">{copy.vsHeading}</h2>
		<ul class="compare-links list-none p-0">
			{COMPARISON_PAIRS.map((pair) => (
				<li><a class="compare-link" href={pagePath(locale, `/vergleich/${pair.slug}`)}>
					<span>{appCopy[locale][pair.left].name} <span class="text-muted">vs.</span> {appCopy[locale][pair.right].name}</span>
					<span aria-hidden="true">→</span>
				</a></li>
			))}
		</ul>
	</section>
	<FaqList items={hubFaqs[locale]} title={faqTitle} />
</BaseLayout>
