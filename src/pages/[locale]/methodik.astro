---
import Breadcrumbs from "@/components/layout/breadcrumbs.astro"
import BaseLayout from "@/components/layout/base-layout.astro"
import { methodikCopy } from "@/content/methodik"
import { navCopy } from "@/content/copy"
import { isLocale, locales } from "@/lib/i18n"
import { defaultHomeHref } from "@/lib/paths"
import { breadcrumbJsonLd } from "@/lib/seo/schema"

export const prerender = true
export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }))

const localeParam = Astro.params.locale ?? ""
if (!isLocale(localeParam)) {
	return Astro.redirect(defaultHomeHref, 308)
}
const locale = localeParam
const copy = methodikCopy[locale]
const crumbs = [
	{ name: navCopy[locale].home, path: "/" },
	{ name: copy.h1, path: "/methodik" },
]
---

<BaseLayout
	locale={locale}
	page={{ description: copy.description, path: "/methodik", title: copy.title }}
	jsonLd={breadcrumbJsonLd(locale, crumbs)}
>
	<Breadcrumbs locale={locale} crumbs={crumbs} />
	<h1 class="text-4xl sm:text-5xl">{copy.h1}</h1>
	{copy.body.map((paragraph) => <p class="mt-5 max-w-2xl text-muted">{paragraph}</p>)}
</BaseLayout>
