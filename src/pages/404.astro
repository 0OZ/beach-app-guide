---
import { Font } from "astro:assets"
import { defaultHomeHref } from "@/lib/paths"
import { SITE_BASE, SITE_NAME } from "@/lib/site"
import "@/styles/global.css"
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Seite nicht gefunden | {SITE_NAME}</title>
		<link rel="icon" href={`${SITE_BASE}/favicon.svg`} type="image/svg+xml" />
		<Font cssVariable="--font-guide" />
	</head>
	<body>
		<main class="site-shell page-main">
			<p class="eyebrow">404</p>
			<h1 class="mt-4 text-4xl">Diese Seite gibt es nicht.</h1>
			<p class="mt-5 text-muted">Zurück zum Guide — finde die App für deinen nächsten Spieltag.</p>
			<a class="cta-button mt-8" href={defaultHomeHref}>Zur Übersicht →</a>
		</main>
	</body>
</html>
