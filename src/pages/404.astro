---
import { defaultHomeHref } from "@/lib/paths"
import { SITE_NAME } from "@/lib/site"
---

<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Not found | {SITE_NAME}</title>
		<style>
			html {
				background: #f1e9d7;
				color: #14282f;
			}
			body {
				align-items: center;
				display: flex;
				font-family: ui-serif, Georgia, serif;
				justify-content: center;
				margin: 0;
				min-height: 100vh;
			}
			main {
				border: 2px solid #14282f;
				box-shadow:
					0 0 0 3px #f1e9d7,
					0 0 0 5px #d9cdb2;
				background: #fbf6ea;
				margin: 1.5rem;
				max-width: 26rem;
				padding: 2.5rem;
			}
			p.code {
				color: #52606a;
				font-family: ui-monospace, "SFMono-Regular", monospace;
				font-size: 0.75rem;
				letter-spacing: 0.14em;
				margin: 0;
				text-transform: uppercase;
			}
			h1 {
				font-family: ui-sans-serif, system-ui, sans-serif;
				font-size: 2rem;
				font-weight: 700;
				letter-spacing: -0.015em;
				margin: 0.75rem 0 0;
			}
			p.hint {
				color: #52606a;
				margin: 1rem 0 0;
			}
			a {
				color: #0b5568;
			}
		</style>
	</head>
	<body>
		<main>
			<p class="code">404 · Out</p>
			<h1>Not found</h1>
			<p class="hint">
				Diese Seite gibt es nicht. Zurück zur{" "}
				<a href={defaultHomeHref}>{SITE_NAME}</a>-Übersicht.
			</p>
		</main>
	</body>
</html>
