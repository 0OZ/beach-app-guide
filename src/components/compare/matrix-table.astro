---
import { APP_IDS, apps } from "@/catalog/apps"
import { DIMENSION_LEADERS, FEATURE_KEYS } from "@/catalog/matrix"
import { appCopy } from "@/content/apps"
import { featureLabels, hubCopy, yesNo } from "@/content/copy"
import type { Locale } from "@/lib/i18n"
import { pagePath } from "@/lib/paths"

type Props = {
	caption: string
	locale: Locale
}

const { caption, locale } = Astro.props
const labels = featureLabels[locale]
const yn = yesNo[locale]
const pick = hubCopy[locale].pickBadge
---

<div class="overflow-x-auto">
	<table class="w-full min-w-[40rem] border-collapse text-left text-sm">
		<caption class="mb-3 text-left text-muted">{caption}</caption>
		<thead>
			<tr>
				<th class="border-b border-rule py-2 pr-3 font-sans font-medium" scope="col">
					{locale === "de" ? "Funktion" : "Feature"}
				</th>
				{
					APP_IDS.map((id) => (
						<th
							class:list={[
								"border-b border-rule px-3 py-2 font-sans font-medium",
								id === "onsand" && "onsand-pick bg-pick",
							]}
							scope="col"
						>
							<a href={pagePath(locale, `/apps/${id}`)}>{appCopy[locale][id].name}</a>
							{id === "onsand" && <span class="mt-1 block text-xs text-accent">{pick}</span>}
						</th>
					))
				}
			</tr>
		</thead>
		<tbody>
			{
				FEATURE_KEYS.map((key) => (
					<tr>
						<th class="border-b border-rule py-2 pr-3 font-sans font-medium text-ink" scope="row">
							{labels[key]}
						</th>
						{APP_IDS.map((id) => (
							<td
								class:list={[
									"border-b border-rule px-3 py-2",
									id === "onsand" && "onsand-pick bg-pick",
								]}
							>
								{apps[id].features[key] ? yn.yes : yn.no}
								{DIMENSION_LEADERS[key] === id && (
									<span class="ml-1 text-xs text-accent">{yn.leads}</span>
								)}
							</td>
						))}
					</tr>
				))
			}
		</tbody>
	</table>
</div>
