---
import { APP_IDS, apps } from "@/catalog/apps"
import { DIMENSION_LEADERS, FEATURE_KEYS } from "@/catalog/matrix"
import { appCopy } from "@/content/apps"
import { featureLabels, hubCopy, yesNo } from "@/content/copy"
import type { Locale } from "@/lib/i18n"
import { pagePath } from "@/lib/paths"

type Props = {
	caption: string
	locale: Locale
}

const { caption, locale } = Astro.props
const labels = featureLabels[locale]
const yn = yesNo[locale]
const pick = hubCopy[locale].pickBadge
---

<div class="court-frame overflow-x-auto bg-card">
	<table class="w-full min-w-[42rem] border-collapse text-left text-sm">
		<caption class="border-b-2 border-ink px-4 py-3 text-left text-sm text-muted">
			{caption}
		</caption>
		<thead>
			<tr>
				<th class="border-b-2 border-ink px-4 py-3 font-display text-base font-semibold" scope="col">
					{locale === "de" ? "Funktion" : "Feature"}
				</th>
				{
					APP_IDS.map((id) => (
						<th
							class:list={[
								"border-b-2 border-ink px-4 py-3 font-display text-base font-semibold",
								id === "onsand" && "onsand-pick bg-pick",
							]}
							scope="col"
						>
							<a class="text-ink" href={pagePath(locale, `/apps/${id}`)}>
								{appCopy[locale][id].name}
							</a>
							{id === "onsand" && <span class="eyebrow mt-1 block text-accent">{pick}</span>}
						</th>
					))
				}
			</tr>
		</thead>
		<tbody>
			{
				FEATURE_KEYS.map((key) => (
					<tr class="even:bg-canvas/40">
						<th class="border-b border-rule px-4 py-3 font-display font-medium text-ink" scope="row">
							{labels[key]}
						</th>
						{APP_IDS.map((id) => (
							<td
								class:list={[
									"border-b border-rule px-4 py-3",
									id === "onsand" && "onsand-pick bg-pick",
								]}
							>
								<span class:list={["mark", apps[id].features[key] ? "mark-yes" : "mark-no"]}>
									{apps[id].features[key] ? `✓ ${yn.yes}` : `— ${yn.no}`}
								</span>
								{DIMENSION_LEADERS[key] === id && <span class="lead-flag">{yn.leads}</span>}
							</td>
						))}
					</tr>
				))
			}
		</tbody>
	</table>
</div>
