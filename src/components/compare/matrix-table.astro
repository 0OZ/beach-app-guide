---
import { APP_IDS, getApp, type AppId } from "@/catalog/apps"
import { FEATURE_KEYS } from "@/catalog/matrix"
import { appCopy } from "@/content/apps"
import { evidenceLabels, featureLabels } from "@/content/copy"
import type { Locale } from "@/lib/i18n"
import { pagePath } from "@/lib/paths"

type Props = { caption: string; ids?: readonly AppId[]; locale: Locale }
const { caption, ids = APP_IDS, locale } = Astro.props
const labels = featureLabels[locale]
const statuses = evidenceLabels[locale]
const sourceLabel = locale === "de" ? "Quelle öffnen" : "Open source"
---

<p class="mb-3 text-xs text-muted sm:hidden">{locale === "de" ? "Seitlich wischen, um alle Apps zu vergleichen →" : "Swipe sideways to compare all apps →"}</p>
<div class="table-scroll" tabindex="0" role="region" aria-label={caption}>
	<table class="comparison-table">
		<caption>{caption}</caption>
		<thead><tr>
			<th scope="col">{locale === "de" ? "Funktion" : "Feature"}</th>
			{ids.map((id) => <th scope="col"><a href={pagePath(locale, `/apps/${id}`)}>{appCopy[locale][id].name}</a></th>)}
		</tr></thead>
		<tbody>
			{FEATURE_KEYS.map((key) => (
				<tr>
					<th scope="row">{labels[key]}</th>
					{ids.map((id) => {
						const evidence = getApp(id).features[key]
						return <td>{evidence.status === "unverified" ? (
							<span class="feature-unknown">{statuses.unverified}</span>
						) : (
							<a class="feature-supported" href={evidence.source} aria-label={`${appCopy[locale][id].name}, ${labels[key]}: ${statuses[evidence.status]}. ${sourceLabel}`}>
								{statuses[evidence.status]} <span aria-hidden="true">↗</span>
							</a>
						)}</td>
					})}
				</tr>
			))}
		</tbody>
	</table>
</div>
