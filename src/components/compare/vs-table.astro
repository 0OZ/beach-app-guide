---
import type { AppId } from "@/catalog/apps"
import { getApp } from "@/catalog/apps"
import { DIMENSION_LEADERS, FEATURE_KEYS } from "@/catalog/matrix"
import { appCopy } from "@/content/apps"
import { featureLabels, yesNo } from "@/content/copy"
import type { Locale } from "@/lib/i18n"

type Props = {
	left: AppId
	locale: Locale
	right: AppId
}

const { left, locale, right } = Astro.props
const labels = featureLabels[locale]
const yn = yesNo[locale]
const leftApp = getApp(left)
const rightApp = getApp(right)
const cells = [
	{ app: leftApp, id: left },
	{ app: rightApp, id: right },
] as const
---

<div class="court-frame overflow-x-auto bg-card">
	<table class="w-full min-w-[30rem] border-collapse text-left text-sm">
		<thead>
			<tr>
				<th class="border-b-2 border-ink px-4 py-3 font-display text-base font-semibold" scope="col">
					{locale === "de" ? "Funktion" : "Feature"}
				</th>
				{
					cells.map((cell) => (
						<th
							class:list={[
								"border-b-2 border-ink px-4 py-3 font-display text-base font-semibold",
								cell.id === "onsand" && "onsand-pick bg-pick",
							]}
							scope="col"
						>
							{appCopy[locale][cell.id].name}
						</th>
					))
				}
			</tr>
		</thead>
		<tbody>
			{
				FEATURE_KEYS.map((key) => (
					<tr class="even:bg-canvas/40">
						<th class="border-b border-rule px-4 py-3 font-display font-medium text-ink" scope="row">
							{labels[key]}
						</th>
						{cells.map((cell) => (
							<td
								class:list={[
									"border-b border-rule px-4 py-3",
									cell.id === "onsand" && "onsand-pick bg-pick",
								]}
							>
								<span class:list={["mark", cell.app.features[key] ? "mark-yes" : "mark-no"]}>
									{cell.app.features[key] ? `✓ ${yn.yes}` : `— ${yn.no}`}
								</span>
								{DIMENSION_LEADERS[key] === cell.id && <span class="lead-flag">{yn.leads}</span>}
							</td>
						))}
					</tr>
				))
			}
		</tbody>
	</table>
</div>
