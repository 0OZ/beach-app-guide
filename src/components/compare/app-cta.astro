---
import { getApp, type AppId } from "@/catalog/apps"
import { appCopy } from "@/content/apps"
import type { Locale } from "@/lib/i18n"
import { ONSAND_COURTS_URL, ONSAND_MATCHMAKING_URL } from "@/catalog/urls"

type Props = { id: AppId; locale: Locale }
const { id, locale } = Astro.props
const app = getApp(id)
const copy = appCopy[locale][id]
const siteLabel = locale === "de" ? "Offizielle Website" : "Official website"
---

<section class="section" aria-labelledby="downloads-heading">
	<h2 id="downloads-heading" class="text-2xl">{locale === "de" ? "Quellen & Downloads" : "Sources & downloads"}</h2>
	<p class="mt-3 text-sm text-muted">{locale === "de" ? "Angaben des Anbieters prüfen und die App selbst ausprobieren." : "Check the developer’s claims and try the app yourself."}</p>
	<nav class="hero-actions" aria-label={`${copy.name} Downloads`}>
		<a class="cta-button" href={app.siteUrl}>{siteLabel} ↗</a>
		<a class="text-link" href={app.appleUrl}>App Store ↗</a>
		<a class="text-link" href={app.playUrl}>Google Play ↗</a>
	</nav>
	{id === "onsand" && <ul class="source-list">
		<li><a href={ONSAND_MATCHMAKING_URL}>{locale === "de" ? "Spielsuche" : "Find games"}</a></li>
		<li><a href={ONSAND_COURTS_URL}>{locale === "de" ? "Plätze finden" : "Find courts"}</a></li>
		{app.clubSoftwareUrl && <li><a href={app.clubSoftwareUrl}>{locale === "de" ? "Separate Vereinssoftware" : "Separate club software"}</a></li>}
	</ul>}
</section>
