---
import { Font } from "astro:assets"
import JsonLd from "@/components/layout/json-ld.astro"
import Footer from "@/components/layout/footer.astro"
import Header from "@/components/layout/header.astro"
import { navCopy } from "@/content/copy"
import type { Locale } from "@/lib/i18n"
import type { JsonLd as JsonLdValue } from "@/lib/seo/schema"
import { resolveMetadata, type PageMetadata } from "@/lib/seo/metadata"
import { SITE_BASE } from "@/lib/site"
import "@/styles/global.css"
import "@/styles/guide.css"

type Props = {
	jsonLd?: JsonLdValue | readonly JsonLdValue[]
	locale: Locale
	page: PageMetadata
}

const { jsonLd, locale, page } = Astro.props
const resolved = resolveMetadata(locale, page)
const nav = navCopy[locale]
const blocks = jsonLd === undefined ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd]
const faviconHref = `${SITE_BASE}/favicon.svg`
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{resolved.title}</title>
		<meta name="description" content={resolved.description} />
		<meta name="author" content={resolved.author} />
		<meta name="robots" content={resolved.robots} />
		<link rel="canonical" href={resolved.canonical} />
		{
			Object.entries(resolved.alternates).map(([language, href]) => (
				<link rel="alternate" hreflang={language} href={href} />
			))
		}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={resolved.siteName} />
		<meta property="og:title" content={resolved.title} />
		<meta property="og:description" content={resolved.description} />
		<meta property="og:locale" content={resolved.locale} />
		<meta property="og:locale:alternate" content={resolved.ogAlternateLocale} />
		<meta property="og:url" content={resolved.canonical} />
		<meta property="article:modified_time" content={resolved.modifiedTime} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={resolved.title} />
		<meta name="twitter:description" content={resolved.description} />
		<link rel="icon" href={faviconHref} type="image/svg+xml" />
		<Font cssVariable="--font-guide" preload />
		{blocks.map((block) => <JsonLd data={block} />)}
	</head>
	<body class="bg-canvas text-ink antialiased">
		<a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4" href="#content">
			{nav.skipToContent}
		</a>
		<Header locale={locale} path={page.path} />
		<main id="content" class="site-shell page-main">
			<slot />
		</main>
		<Footer locale={locale} />
	</body>
</html>
