---
import { LEGAL_SLUGS, legalCopy } from "@/content/legal"
import { hubCopy, navCopy } from "@/content/copy"
import type { Locale } from "@/lib/i18n"
import { pagePath } from "@/lib/paths"
import { SITE_NAME } from "@/lib/site"

type Props = { locale: Locale }
const { locale } = Astro.props
const nav = navCopy[locale]
---

<footer class="site-footer">
	<div class="site-shell footer-inner">
		<div>
			<span class="font-semibold">{SITE_NAME}</span>
			<p class="mt-2">{hubCopy[locale].disclosure}</p>
		</div>
		<nav class="footer-links" aria-label={nav.legal}>
			<a href={pagePath(locale, "/methodik")}>{nav.methodology}</a>
			{LEGAL_SLUGS.map((slug) => <a href={pagePath(locale, `/legal/${slug}`)}>{legalCopy[locale][slug].title}</a>)}
		</nav>
	</div>
</footer>
