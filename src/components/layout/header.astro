---
import LocaleSwitch from "@/components/layout/locale-switch.astro"
import { navCopy } from "@/content/copy"
import type { Locale } from "@/lib/i18n"
import { pagePath } from "@/lib/paths"
import { SITE_NAME } from "@/lib/site"

type Props = { locale: Locale; path: string }
const { locale, path } = Astro.props
const nav = navCopy[locale]
---

<header class="site-header">
	<div class="site-shell header-inner">
		<a class="brand" href={pagePath(locale, "/")}>
			<span class="brand-mark" aria-hidden="true">↗</span>{SITE_NAME}
		</a>
		<nav class="primary-nav" aria-label={locale === "de" ? "Hauptnavigation" : "Primary navigation"}>
			<a href={`${pagePath(locale, "/")}#profiles`}>{nav.apps}</a>
			<a href={`${pagePath(locale, "/")}#features`}>{nav.comparisons}</a>
			<a href={pagePath(locale, "/methodik")} aria-current={path === "/methodik" ? "page" : undefined}>{nav.methodology}</a>
			<LocaleSwitch locale={locale} path={path} />
		</nav>
	</div>
</header>
